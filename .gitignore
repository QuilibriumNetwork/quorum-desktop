# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# dependencies
.vite/
/node_modules
/.pnp
.pnp.js
.vite

# CRITICAL: Prevent npm/yarn conflicts
package-lock.json

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local development configs
*.local.js
*.local.ts
*.local.json

npm-debug.log*
yarn-debug.log*
yarn-error.log*
vite-dev.log

# VS Code workspace settings
.vscode/settings.json

# backup files
*.bak

# DM harness — real private keys / ratchet key material, keep local
src/dev/tests/harness/.state/
src/dev/tests/harness/logs/

# custom
.claude/settings.local.json
.mcp.json
.claude/skills/changelog-generator/changelogs/*.md
.claude/skills/changelog-generator/changelogs/*.txt
.temp/
.worktrees/

# Security-sensitive issue reports. This repo is PUBLIC, so any write-up that
# describes a working attack against shipped code is held here and never
# tracked. See .agents/AGENTS.md -> "Security-sensitive issues (.secret/)".
.agents/issues/.secret/

# Logs and captures. Regenerated every run; carry account/machine names and,
# in transport traces, real key material.
.agents/**/*.log
.agents/**/*-log.txt
.agents/**/logs/
.agents/**/captures/

# Local verify receipts. Machine-specific, regenerated every run.
/.verify-receipt.json



